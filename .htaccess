# KamaGrooming – konfiguracja serwera (Apache)
RewriteEngine On

# 1) Zawsze HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Zawsze z www (odkomentuj i wpisz swoją domenę)
# RewriteCond %{HTTP_HOST} ^kamagrooming\.pl$ [NC]
# RewriteRule ^ https://www.kamagrooming.pl%{REQUEST_URI} [L,R=301]

# Typy plików aplikacji
AddType application/manifest+json .webmanifest
AddDefaultCharset utf-8

# Kompresja
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/manifest+json image/svg+xml
</IfModule>

# Cache: zdjęcia i ikony długo, strona i service worker zawsze świeże
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

DirectoryIndex index.php index.html

# Ładne adresy dokumentów prawnych
RewriteRule ^(polityka-prywatnosci|regulamin-rezerwacji)/?$ $1.php [L]
Options -Indexes
